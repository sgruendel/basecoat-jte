{
  "name": "basecoat-jte",
  "version": "1.3.0",
  "description": "basecoat UI components for JTE",
  "author": "Stefan Gründel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgruendel/basecoat-jte.git"
  },
  "bugs": {
    "url": "https://github.com/sgruendel/basecoat-jte/issues"
  },
  "homepage": "https://github.com/sgruendel/basecoat-jte#readme",
  "keywords": [
    "basecoat",
    "jte",
    "template"
  ],
  "scripts": {
    "generate:kitchen-sink-jte": "node scripts/convert-kitchen-sink.js",
    "dev": "vite --open",
    "build": "vite build",
    "sync-version": "node scripts/sync-version.js",
    "test": "node --test scripts/*.test.js",
    "release:maven-central": "mise exec java@temurin-21 -- ./mvnw --no-transfer-progress -Prelease -pl basecoat-jte clean verify",
    "publish:maven-central": "mise exec java@temurin-21 -- ./mvnw --no-transfer-progress -Prelease -pl basecoat-jte -DautoPublish=true -DwaitUntil=published deploy"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "basecoat-css": "1.3.0",
    "chart.js": "^4.6.1",
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "prettier": "^3.10.1",
    "prettier-plugin-jte": "^1.7.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "private": true
}
