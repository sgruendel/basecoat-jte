{
  "printWidth": 120,
  "singleQuote": true,
  "tabWidth": 4,
  "plugins": [
    "prettier-plugin-jte",
    "prettier-plugin-tailwindcss"
  ],
  "overrides": [
    {
      "files": [
        "*.json",
        "*.jsonc",
        "*.yml",
        "*.yaml"
      ],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": "*.md",
      "options": {
        "tabWidth": 2,
        "proseWrap": "always"
      }
    }
  ]
}
